# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test
# But keep Docker test files
!Dockerfile.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
ops/ansible/inventory.ini
ops/ansible/group_vars/telegram_server.yml
ops/ansible/group_vars/telegram_server.vault.yml

artifacts/
*.pkg.tar.zst
src/
pkg/
.vscode/
build/
.idea/

.DS_Store

coverage.html
coverage.out
coverage.txt
*.cover
test-results/
test-output/
*.test.log

# Security and CI reports
gosec-report.json
*.sarif

# Binary files
telegram-media-server
*.torrent
# Integration fixture (keep in git despite *.torrent above)
!integration/fixtures/big-buck-bunny.torrent

.mypy_cache/
__pycache__/
logs.txt

.cursor/
